{
  "name": "@opendata.cat/mcp-server",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.6.1",
  "description": "MCP server for querying Catalan public open data — 15 portals + radio archive (radioteca.cat): government, Spanish stats, CORA research, Catalònica heritage (~2.2M items)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opendata-cat-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "sync-skills": "rm -rf skills && cp -r ../opendata.cat/public/api/skills skills"
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "keywords": [
    "mcp",
    "opendata",
    "catalunya",
    "dades-obertes"
  ],
  "author": "opendata.cat",
  "license": "MIT",
  "mcpName": "io.github.xaviviro/opendata-cat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaviviro/Opendata.cat-MCP-Server.git"
  },
  "bugs": {
    "url": "https://github.com/xaviviro/Opendata.cat-MCP-Server/issues"
  },
  "homepage": "https://github.com/xaviviro/Opendata.cat-MCP-Server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "gtfs-realtime-bindings": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  }
}
